# Copy to .env.local and fill in. Never commit the real file.

# Where the app is served (used in email links)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Supabase (required). Project settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Calendar (required). An OAuth client with the Calendar scope,
# plus a refresh token for the calendar you book against.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# Stripe (optional). Leave unset in development and paid types confirm like free ones.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend (optional). Leave unset and emails print to the console.
RESEND_API_KEY=
EMAIL_FROM=Bookings <bookings@example.com>
HOST_EMAIL=you@example.com

# Optional: POST a JSON event here on every confirm, cancel and reschedule.
BOOKING_WEBHOOK_URL=

# Optional: Vercel Cron sends this as a Bearer token to /api/cron/reminders.
CRON_SECRET=
